OPENAI_API_KEY=your-openai-api-key-here

# اختیاری — مدل مورد استفاده برای گیم‌مستر
OPENAI_MODEL=gpt-4o

# اختیاری — سقف توکن خروجی هر پاسخ گیم‌مستر
OPENAI_MAX_TOKENS=4096

# اختیاری — پورت سرور
PORT=8787

# اختیاری — ذخیره‌ی دائمی وضعیت بازی روی Upstash Redis (رایگان).
# اگر این دو تا خالی بمونن، بازی روی دیسک محلی ذخیره می‌شه (کافی برای تست
# محلی، ولی روی هاست رایگان Render با هر دیپلوی پاک می‌شه).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
